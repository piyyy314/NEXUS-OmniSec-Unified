# NEXUS OmniSec Unified — Environment Configuration
# Copy this file to .env and supply your credentials

# Gemini AI API Configuration
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Core Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT & Security Secret
JWT_SECRET=your_jwt_secret_here

# Firebase Configuration (Optional - for Cloud Telemetry & Sync)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Quantum Engine Simulation Mode
QUANTUM_SIMULATOR_BACKEND=aer_simulator
PQC_ALGORITHM_SUITE=FIPS_203_204_205
