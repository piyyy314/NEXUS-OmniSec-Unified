# Copy this file to .env and replace both generated secrets.
# Generate values with: openssl rand -hex 32
SHADOW313_API_KEY=replace-with-a-long-random-api-key
WEBUI_SECRET_KEY=replace-with-a-different-long-random-secret

# Host path for persistent NEXUS state; prepare it with:
# sudo sh deploy/bootstrap.sh
SHADOW313_DATA_DIR=/opt/shadow313/data
SHADOW313_EVENTS_DB=/home/shadow313/.shadow313/events.sqlite3

# Optional Telegram profile settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SEVERITY=HIGH
TELEGRAM_POLL_INTERVAL=10
